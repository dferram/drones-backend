# Genera SECRET_KEY con: openssl rand -hex 32
PROJECT_NAME ="Drones-Autonomos API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

#base de datos
DATABASE_URL="postgresql://drone_user:drone_password@localhost:5432/drone_db"

#Seguridad y autenticacion jwt
SECRET_KEY=
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Activar solo tras aplicar migraciones y conectar el simulador.
# Ejecuta misiones vencidas PROGRAMADAS; false permite únicamente inicio manual.
MISSION_SCHEDULER_ENABLED=false

# Reglas de eventos: horario local y agrupación de evidencia por vuelo.
EVENT_TIMEZONE=America/Mexico_City
EVENT_DEDUP_SECONDS=60
EVENT_DEDUP_RADIUS_M=30

# Video desactivado por defecto; fuente sintética o archivo local en bucle.
VIDEO_ENABLED=false
VIDEO_SOURCE=synthetic
VIDEO_FILE=
VIDEO_WIDTH=640
VIDEO_HEIGHT=360
VIDEO_FPS=10
VIDEO_JPEG_QUALITY=80
VIDEO_STALE_SECONDS=3
VIDEO_RECONNECT_SECONDS=1
VIDEO_STREAM_SECONDS=60
